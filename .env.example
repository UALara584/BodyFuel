# Base de datos PostgreSQL usada por docker-compose
POSTGRES_USER=bodyfuel
POSTGRES_PASSWORD=bodyfuel
POSTGRES_DB=bodyfuel

# API externa de alimentos: https://developer.edamam.com/food-database-api
EDAMAM_APP_ID=tu_app_id_de_edamam
EDAMAM_APP_KEY=tu_app_key_de_edamam

# URL que consume el frontend.
# Dejala vacia para que use automaticamente el host desde el que abres la app.
VITE_API_BASE_URL=

# URLs externas usadas por el scraper de recetas de Vitonica
VITONICA_URLS=https://www.vitonica.com/categoria/recetas-saludables/record/20,https://www.vitonica.com/categoria/recetas-saludables/record/40,https://www.vitonica.com/categoria/recetas-saludables/record/60,https://www.vitonica.com/categoria/recetas-saludables/record/80,https://www.vitonica.com/categoria/recetas-saludables/record/100

# Opcional: proveedor LLM para el asistente nutricional
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
